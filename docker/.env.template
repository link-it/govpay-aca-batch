##############################################################################
# GovPay ACA Batch - variabili d'ambiente del container
#
# Uso: cp .env.template .env, poi
#   docker run --rm --env-file .env -v ./jdbc-drivers:/opt/jdbc-drivers linkitaly/govpay-aca-batch
# Elenco completo delle variabili: README.md, sezione "Esecuzione con Docker".
##############################################################################

# Database (obbligatorie)
GOVPAY_DB_TYPE=postgresql
GOVPAY_DB_SERVER=postgres:5432
GOVPAY_DB_NAME=govpay
GOVPAY_DB_USER=govpay
GOVPAY_DB_PASSWORD=

# Parametri aggiuntivi dell'URL JDBC e formato dell'URL Oracle (servicename o sid)
# GOVPAY_DS_CONN_PARAM=
# GOVPAY_ORACLE_JDBC_URL_TYPE=servicename

# Pool di connessioni
# GOVPAY_ACA_MIN_POOL=2
# GOVPAY_ACA_MAX_POOL=10

# Modalita': non impostata = esecuzione singola (il container termina a fine job);
# true = scheduler interno, ogni GOVPAY_ACA_BATCH_INTERVALLO_CRON minuti
# GOVPAY_ACA_BATCH_USA_CRON=true
# GOVPAY_ACA_BATCH_INTERVALLO_CRON=5
# SERVER_PORT=10001

# Creazione delle tabelle Spring Batch e delle viste del batch che mancano
# GOVPAY_ACA_POP_DB_SKIP=FALSE

# Memoria della JVM
# GOVPAY_ACA_JVM_MAX_RAM_PERCENTAGE=80
