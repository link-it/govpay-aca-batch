# Modello di configurazione per CollaudoGpd.
# Copiare in un file fuori dal repository (per esempio ~/gpd-collaudo.env), inserire i valori
# reali, proteggerlo con "chmod 600" e caricarlo con "source ~/gpd-collaudo.env".
# Non inserire mai in questo file valori reali.

# --- Obbligatorie ---

# URL base delle API v3, senza "/organizations/..."
export GPD_COLLAUDO_BASE_URL=https://api.uat.platform.pagopa.it/gpd/debt-positions-service/v3

# Subscription key delle API GPD
export GPD_COLLAUDO_API_KEY=

# Codice fiscale dell'ente creditore configurato sul collaudo (meglio un ente dedicato ai test)
export GPD_COLLAUDO_ENTE=

# IBAN di accredito dell'ente
export GPD_COLLAUDO_IBAN=

# --- Facoltative (valori predefiniti indicati) ---

# Nome dell'header della chiave (default Ocp-Apim-Subscription-Key)
# export GPD_COLLAUDO_API_KEY_HEADER=Ocp-Apim-Subscription-Key

# Codice di segregazione a due cifre per gli IUV (default 01)
# export GPD_COLLAUDO_SEGREGAZIONE=01

# Prefisso degli IUPD di prova (default GVPTEST)
# export GPD_COLLAUDO_PREFISSO=GVPTEST

# Intervallo e durata massima delle osservazioni, in secondi (default 2 e 30)
# export GPD_COLLAUDO_OSSERVAZIONE_INTERVALLO_SECONDI=2
# export GPD_COLLAUDO_OSSERVAZIONE_DURATA_SECONDI=30

# Pausa prima di ogni chiamata, in millisecondi (default 0)
# export GPD_COLLAUDO_PAUSA_MILLISECONDI=0

# Cartella delle registrazioni (default ~/gpd-collaudo)
# export GPD_COLLAUDO_USCITA=$HOME/gpd-collaudo
