<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archivio degli script SQL che finiscono in /opt/sql nelle immagini Docker.

  Contiene due parti nettamente separate:
    sql/spring-batch/  schemi e migrazioni dei metadati Spring Batch, estratti
                       verbatim da spring-batch-core, mai modificati da noi
    sql/<vendor>/      script delle tabelle applicative, nostri

  Prodotto dal profilo "dist" come target/sql.zip, consumato dalla pipeline
  (immagine di sviluppo, asset di release) e da docker/build_image.sh.
-->
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">

    <id>sql</id>

    <formats>
        <format>zip</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <!-- Schemi ufficiali Spring Batch, cosi' come li spedisce la libreria -->
        <fileSet>
            <directory>${project.build.directory}/sql-upstream/org/springframework/batch/core</directory>
            <outputDirectory>sql/spring-batch</outputDirectory>
            <includes>
                <include>schema-*.sql</include>
                <include>migration/**</include>
            </includes>
        </fileSet>

        <!-- Script delle tabelle applicative -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources/sql</directory>
            <outputDirectory>sql</outputDirectory>
            <includes>
                <include>**/*.sql</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <!-- Tracciabilita': quale schema c'e' dentro questa immagine -->
        <file>
            <source>${project.basedir}/src/assembly/VERSION</source>
            <outputDirectory>sql</outputDirectory>
            <destName>VERSION</destName>
            <filtered>true</filtered>
        </file>
    </files>

</assembly>
